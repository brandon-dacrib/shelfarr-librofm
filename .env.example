LIBROFM_USERNAME=reader@example.com
LIBROFM_PASSWORD=replace-me
# Random 32+ character secret, e.g. generated by `openssl rand -hex 32`.
DOWNLOAD_SIGNING_KEY=replace-with-a-long-random-secret
# Shelfarr must be able to reach this URL. Use its in-cluster service name on Kubernetes.
PUBLIC_BASE_URL=http://librofm-shelfarr-provider:8080
# Optional: configure the same value in Shelfarr's Acquisition Provider settings.
PROVIDER_BEARER_TOKEN=
